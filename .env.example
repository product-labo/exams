# Copy to .env and fill in. Never commit .env.

# The ONE wallet allowed to administer, and the treasury that receives the fees (public address, starts with 0x).
ADMIN_WALLET=
# Long random string used to sign login sessions. Generate one, for example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# AI question generation and fuzzy answer matching (free key from Google AI Studio). Leave empty to disable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Blockchain: Base mainnet. For testing use Base Sepolia: RPC https://sepolia.base.org, CHAIN_ID 84532, explorer https://sepolia.basescan.org/tx/
RPC_URL=https://mainnet.base.org
RPC_FALLBACK_URLS=
CHAIN_NAME=base
CHAIN_ID=8453
EXPLORER_TX_URL=https://basescan.org/tx/
# Native USDC on Base mainnet
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Address of your deployed ResultRegistry (see contracts/). Empty = payments disabled.
CONTRACT_ADDRESS=
# Fee per result in USDC base units (6 decimals): 100000 = 0.10 USDC. Read by the deploy script.
FEE_UNITS=100000
# Set to true when DATABASE_URL points at a managed Postgres that requires SSL (Neon, Supabase, Render external URL).
DATABASE_SSL=false
# Unpaid results are deleted after this many days.
UNPAID_EXPIRY_DAYS=5

# ONLY used by contracts/scripts/deploy.cjs to pay gas for deploying the contract. The running app never signs transactions.
# Use a fresh wallet holding a little ETH on Base.
ANCHOR_PRIVATE_KEY=
